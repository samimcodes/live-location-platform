# ============================================================
# LocaLink - Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL="postgresql://postgres:samim123@localhost:5432/localink?schema=public"

# ---- JWT ----
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Authentication ---
JWT_SECRET="3ff83a8b417c8ad881a7b8e5c26b9a2155e8c14856f6b5b1424e8e19e7a884fa"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="ef4b321a5d2e7d7168abef2256df926c48f8a147e62a1b945d8b8e21a814c3e8"
JWT_REFRESH_EXPIRES_IN="7d"


# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@localink.app
FROM_NAME=LocaLink

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---- Facebook OAuth ----
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# ---- Map (MapLibre GL JS + OpenStreetMap — no API key required) ----
# Default center coordinates for the map [longitude, latitude]
NEXT_PUBLIC_MAP_DEFAULT_LNG=90.4125
NEXT_PUBLIC_MAP_DEFAULT_LAT=23.8103
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# ---- Twilio (SMS) ----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ---- Upload ----
MAX_FILE_SIZE=5242880
UPLOAD_DIR=public/uploads
